<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Path to the ProtectApp properties file. May be absolute or relative to the executable. -->
    <add key="PropertiesFilePath" value="C:\Program Files\SafeNet ProtectApp\DotNet\ProtectAppForDotNet.properties"/>
    <!-- Static test value (STV) used as plaintext input for encrypt/decrypt operations. -->
    <add key="StaticTestValue" value="*** sensitive data protected ***"/>
    <!-- Default values pre-populated in the startup dialog. -->
    <add key="DefaultUsername" value=""/>
    <add key="DefaultPassword" value=""/>
    <add key="DefaultKeyName" value="your_key_name"/>
    <add key="DefaultDuration" value="1800"/>
  </appSettings>
  <runtime>
    <!--
      Allow catch(Exception) to intercept corrupted-state exceptions (AccessViolationException,
      SEHException, etc.) thrown by the native ingdnp.dll when the ProtectApp service drops.
      Without this, .NET 4.0+ lets those exceptions escape all managed catch blocks.
    -->
    <legacyCorruptedStateExceptionsPolicy enabled="true"/>
  </runtime>
</configuration>
