<Window x:Class="CMPADotNetTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CMPADotNetTest.Controls"
        Title="CM ProtectApp .Net Testing"
        MinWidth="900" MinHeight="600"
        Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        Foreground="#E0E0E0"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="TimerText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00BCD4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="CtaButton" TargetType="Button">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="#0F3460">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0A0F1A" Offset="0"/>
                    <GradientStop Color="#16213E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & key info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CM ProtectApp" FontSize="18" FontWeight="Bold"
                               Foreground="#00BCD4" VerticalAlignment="Center"/>
                    <TextBlock Text=" .Net Testing" FontSize="18" FontWeight="Light"
                               Foreground="#B0BEC5" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="#2A3F6F" Margin="16,0"/>
                    <TextBlock Text="Key: " Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtKeyDisplay" Text="--" Foreground="#90CAF9"
                               FontSize="11" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="#2A3F6F" Margin="16,0"/>
                    <TextBlock Text="User: " Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtUserDisplay" Text="--" Foreground="#90CAF9"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Timer display -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="TxtTimerLabel" Text="TIME REMAINING"
                               Style="{StaticResource DimText}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtTimer" Text="00:00:00"
                               Style="{StaticResource TimerText}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Run status badge -->
                <Border Grid.Column="2" CornerRadius="4" Padding="12,6" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <Border.Background>
                        <SolidColorBrush x:Name="StatusBadgeBrush" Color="#1B3A2A"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <SolidColorBrush x:Name="StatusDotBrush" Color="#4CAF50"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="TxtRunStatus" Text="RUNNING"
                                   Foreground="#4CAF50" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Menu buttons: Restart | Exit -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRestart" Content="Restart"
                            Style="{StaticResource MenuButton}"
                            Background="#1565C0" Margin="0,0,6,0"
                            Click="BtnRestart_Click"/>
                    <Button x:Name="BtnMenuExit" Content="Exit"
                            Style="{StaticResource MenuButton}"
                            Background="#B71C1C"
                            Click="BtnMenuExit_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Run-complete banner (hidden until done) -->
        <!-- Progress bar strip just below header -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="3">
            <ProgressBar x:Name="OverallProgress" Minimum="0" Maximum="100" Value="0"
                         Height="3" BorderThickness="0">
                <ProgressBar.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00BCD4" Offset="0"/>
                        <GradientStop Color="#9C27B0" Offset="1"/>
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
                <ProgressBar.Background>
                    <SolidColorBrush Color="#0D1B2A"/>
                </ProgressBar.Background>
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
        </Border>

        <!-- Two session panels -->
        <Grid Grid.Row="1" x:Name="PanelsGrid" Margin="6,6,6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:SessionPanel Grid.Column="0"
                x:Name="PersistentPanel"
                Title="Persistent Session Testing"
                AccentColor="#00838F"/>

            <controls:SessionPanel Grid.Column="1"
                x:Name="DynamicPanel"
                Title="Dynamic Session Testing"
                AccentColor="#7B1FA2"/>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="#0F3460"
                Background="#0A0F1A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Run-complete notice -->
                <StackPanel x:Name="RunCompletePanel" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse Width="10" Height="10" Fill="#2196F3"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Test run complete. Review results above before exiting."
                               Foreground="#90CAF9" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <TextBlock x:Name="TxtStatusBar" Grid.Column="0"
                           Text="Initializing..." Foreground="#546E7A"
                           FontSize="11" VerticalAlignment="Center"/>

                <Button Grid.Column="1" x:Name="BtnExit"
                        Content="Exit Application" Style="{StaticResource CtaButton}"
                        Background="#B71C1C" IsEnabled="False"
                        Click="BtnExit_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
