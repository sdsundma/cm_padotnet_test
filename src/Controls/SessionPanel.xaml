<UserControl x:Class="CMPADotNetTest.Controls.SessionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CMPADotNetTest.Controls">

    <UserControl.Resources>
        <!-- Gauge bar style -->
        <Style x:Key="GaugeProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="3000"/>
            <Setter Property="Background" Value="#0D1B2A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="7"/>
                            <Border x:Name="PART_Track" CornerRadius="7" Background="#0D1B2A" BorderBrush="#1E3A5F" BorderThickness="1"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="7">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4CAF50" Offset="0"/>
                                        <GradientStop Color="#FFC107" Offset="0.4"/>
                                        <GradientStop Color="#FF9800" Offset="0.7"/>
                                        <GradientStop Color="#F44336" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid column header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="#90CAF9"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#1E3A5F"/>
        </Style>

        <!-- DataGrid cell style -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- DataGrid row style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E3A5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#16213E" CornerRadius="6"
            BorderBrush="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
            BorderThickness="1" Margin="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Panel header -->
            <Border Grid.Row="0" CornerRadius="6,6,0,0" Padding="12,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0F3460" Offset="0"/>
                        <GradientStop Color="#16213E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Fill="{Binding ViewModel.StatusColor, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                   FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Iter: " Foreground="#78909C" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ViewModel.Iteration, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                   Foreground="#E0E0E0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   MinWidth="40"/>
                        <TextBlock Text="Reconnects: " Foreground="#78909C" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBlock Text="{Binding ViewModel.SessionReconnects, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                   Foreground="#FF9800" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   MinWidth="30"/>
                        <TextBlock Text="{Binding ViewModel.StatusText, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                   Foreground="#90A4AE" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats DataGrid -->
            <DataGrid Grid.Row="1" Margin="8,6,8,2"
                      ItemsSource="{Binding ViewModel.StatsRows, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                      Background="Transparent" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#1E3A5F" RowBackground="Transparent"
                      AlternatingRowBackground="#0D1B2A" BorderThickness="1" BorderBrush="#1E3A5F"
                      SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Operation"  Binding="{Binding OperationType}" Width="110"/>
                    <DataGridTextColumn Header="Count"      Binding="{Binding Count}"          Width="55"/>
                    <DataGridTextColumn Header="Current"    Binding="{Binding CurrentDisplay}" Width="70"/>
                    <DataGridTextColumn Header="Avg"        Binding="{Binding AvgDisplay}"     Width="70"/>
                    <DataGridTextColumn Header="Min"        Binding="{Binding MinDisplay}"     Width="65"/>
                    <DataGridTextColumn Header="Max"        Binding="{Binding MaxDisplay}"     Width="65"/>
                    <DataGridTextColumn Header="Errors"     Binding="{Binding ErrorCount}"     Width="55"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Gauges -->
            <Border Grid.Row="2" Margin="8,4" Padding="8,6"
                    Background="#0D1B2A" CornerRadius="4" BorderBrush="#1E3A5F" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Session Open gauge -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Session Open" Foreground="#78909C" FontSize="10" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Style="{StaticResource GaugeProgressBar}"
                                     Value="{Binding ViewModel.SessionOpenStats.CurrentMs, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                     Margin="4,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ViewModel.SessionOpenStats.CurrentDisplay, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                   Foreground="#90CAF9" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Encrypt gauge -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Encrypt" Foreground="#78909C" FontSize="10" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Style="{StaticResource GaugeProgressBar}"
                                     Value="{Binding ViewModel.EncryptStats.CurrentMs, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                     Margin="4,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ViewModel.EncryptStats.CurrentDisplay, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                   Foreground="#A5D6A7" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Decrypt gauge -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Decrypt" Foreground="#78909C" FontSize="10" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Style="{StaticResource GaugeProgressBar}"
                                     Value="{Binding ViewModel.DecryptStats.CurrentMs, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                     Margin="4,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ViewModel.DecryptStats.CurrentDisplay, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                                   Foreground="#CE93D8" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Log header -->
            <TextBlock Grid.Row="3" Text="OPERATION LOG"
                       Foreground="#546E7A" FontSize="9" FontWeight="SemiBold"
                       Margin="12,4,0,2"/>

            <!-- Scrolling log -->
            <Border Grid.Row="4" Margin="8,0,8,8" CornerRadius="4"
                    Background="#0A0F1A" BorderBrush="#1E3A5F" BorderThickness="1">
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding ViewModel.LogEntries, RelativeSource={RelativeSource AncestorType=local:SessionPanel}}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                       Foreground="#90A4AE" TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="2,1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E3A5F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Grid>
    </Border>
</UserControl>
